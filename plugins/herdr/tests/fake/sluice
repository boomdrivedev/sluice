#!/bin/sh
# A stand-in sluice: logs each call with where it ran, and answers from
# the test's files, keyed by a folder's name.
here=$(basename "$PWD")
printf '%s: %s\n' "$here" "$*" >>"$FAKE/sluice-calls"
[ "$*" = --version ] && echo "sluice 0.0.0" && exit 0

# The lines of watch-<folder>.jsonl, each with `folder` in it, as
# `sluice host` sends a folder's first document; none where the test left
# none, as before `sluice host` answers.
first() {
  b=$(basename "$1")
  [ -f "$FAKE/watch-$b.jsonl" ] || return 0
  jq -c --arg f "$1" '{folder: $f} + .' "$FAKE/watch-$b.jsonl"
}

case "$*" in
"overview --json --watch --stdin")
  # Its pid, under the test's own directory, for the test to tell that
  # this source ended: the watcher execs it, so it is the source's pid.
  echo $$ >>"$FAKE/watch-pids"
  served=$FAKE/served.$$
  : >"$served"
  # While the test holds it, each folder served prints next-<folder>.jsonl
  # when a test puts it there, as `sluice host` sends a document when the
  # queue changes; it ends with this process.
  me=$$
  (
    while kill -0 "$me" 2>/dev/null; do
      if [ -f "$FAKE/hold" ]; then
        while IFS= read -r f; do
          n=$FAKE/next-$(basename "$f").jsonl
          [ -f "$n" ] || continue
          jq -c --arg f "$f" '{folder: $f} + .' "$n"
          rm -f "$n"
        done <"$served"
      fi
      sleep 1
    done
  ) &
  while IFS= read -r l; do
    printf '%s %s\n' "$me" "$l" >>"$FAKE/stdin-lines"
    case $l in
    "add "*)
      echo "${l#add }" >>"$served"
      first "${l#add }"
      ;;
    "remove "*)
      grep -vxF -- "${l#remove }" "$served" >"$served.tmp"
      mv -f "$served.tmp" "$served"
      ;;
    "forecast "*)
      f=${l#forecast }
      sh "$(dirname "$0")/../forecast-answer.sh" "${f%% *}" "${f#* }"
      ;;
    esac
  done
  # Its input closed: held open while the test wants it, as a watch that
  # serves folders goes on.
  while [ -f "$FAKE/hold" ]; do sleep 1; done
  rm -f "$served"
  ;;
*) exit 2 ;;
esac
